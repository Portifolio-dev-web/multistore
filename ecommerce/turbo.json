{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "STOREFRONT_URL",
    "STOREFRONT_ROOT_DOMAIN",
    "STOREFRONT_INTERNAL_URL",
    "S3_*",
    "SMTP_*",
    "MAIL_FROM",
    "AUTH_SECRET",
    "COOKIE_SECURE",
    "ALLOW_REGISTRATION",
    "ANTHROPIC_API_KEY",
    "ANTHROPIC_MODEL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
