{
  "name": "vitrine-commerce",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "e2e": "yarn workspace e2e test",
    "db:generate": "yarn workspace @repo/db db:generate",
    "db:migrate": "yarn workspace @repo/db db:migrate",
    "db:deploy": "yarn workspace @repo/db db:deploy",
    "db:seed": "yarn workspace @repo/db db:seed"
  },
  "devDependencies": {
    "turbo": "^2.0.9",
    "typescript": "^5.5.3"
  },
  "packageManager": "yarn@1.22.22"
}
