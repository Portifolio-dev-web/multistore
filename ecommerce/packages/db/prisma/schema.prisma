generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  description  String?
  logoUrl      String?
  primaryColor String    @default("#1f2937")
  accentColor  String    @default("#f59e0b")
  currency     String    @default("brl")
  customDomain String?   @unique
  nextOrderNumber Int    @default(1001)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]
  orders       Order[]
  users        User[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([storeId])
}

model Product {
  id           String      @id @default(cuid())
  storeId      String
  store        Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name         String
  description  String      @default("")
  category     String?
  priceInCents Int
  images       String[]
  stock        Int         @default(0)
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  orderItems   OrderItem[]

  @@index([storeId, active])
  @@index([storeId, category])
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  SHIPPED
  DELIVERED
}

model Order {
  id                      String            @id @default(cuid())
  publicToken             String            @unique @default(dbgenerated("gen_random_uuid()::text"))
  storeId                 String
  store                   Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  number                  Int
  status                  OrderStatus       @default(PENDING)
  fulfillmentStatus       FulfillmentStatus @default(UNFULFILLED)
  carrier                 String?
  trackingCode            String?
  trackingUrl             String?
  shippedAt               DateTime?
  deliveredAt             DateTime?
  shippingAddress         Json?
  confirmationEmailSentAt DateTime?
  stockReleasedAt         DateTime?
  customerEmail         String?
  customerName          String?
  totalInCents          Int
  currency              String      @default("brl")
  stripeSessionId       String?     @unique
  stripePaymentIntentId String?
  paidAt                DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  items                 OrderItem[]

  @@unique([storeId, number])
  @@index([storeId, status])
  @@index([storeId, createdAt])
}

model OrderItem {
  id               String   @id @default(cuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName      String
  unitPriceInCents Int
  quantity         Int

  @@index([orderId])
}
