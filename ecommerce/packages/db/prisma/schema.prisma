generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  description  String?
  logoUrl      String?
  primaryColor String    @default("#1f2937")
  accentColor  String    @default("#f59e0b")
  currency     String    @default("brl")
  customDomain String?   @unique
  nextOrderNumber Int    @default(1001)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]
  orders       Order[]
  users        User[]
  slugRedirects SlugRedirect[]
  categories   Category[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([storeId])
}

model Product {
  id           String      @id @default(cuid())
  storeId      String
  store        Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name         String
  slug         String
  description  String      @default("")
  priceInCents Int
  compareAtPriceInCents Int?
  promoStartsAt DateTime?
  promoEndsAt   DateTime?
  images       String[]
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  orderItems   OrderItem[]
  redirects    SlugRedirect[]
  categories   Category[]
  options      ProductOption[]
  variants     ProductVariant[]

  @@unique([storeId, slug])
  @@index([storeId, active])
}

model ProductOption {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  values    String[]
  position  Int      @default(0)

  @@index([productId])
}

// Produto sem opções tem uma única variante "padrão" (combination: {}) — é nela que o estoque mora.
model ProductVariant {
  id                    String      @id @default(cuid())
  productId             String
  product               Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                   String?
  combination           Json        @default("{}")
  priceInCents          Int?
  compareAtPriceInCents Int?
  stock                 Int         @default(0)
  weightInGrams         Int?
  imageUrl              String?
  position              Int         @default(0)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  orderItems            OrderItem[]

  @@index([productId])
}

model Category {
  id          String     @id @default(cuid())
  storeId     String
  store       Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String     @default("")
  imageUrl    String?
  position    Int        @default(0)
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([storeId, slug])
  @@index([storeId, parentId])
}

model SlugRedirect {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  fromSlug  String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([storeId, fromSlug])
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  SHIPPED
  DELIVERED
}

enum OrderEventType {
  CREATED
  PAID
  FAILED
  EXPIRED
  SHIPPED
  DELIVERED
  CANCELED
  REFUNDED
  EMAIL_SENT
  NOTE
}

enum OrderEventActor {
  SYSTEM
  MERCHANT
  CUSTOMER
}

model Order {
  id                      String            @id @default(cuid())
  publicToken             String            @unique @default(dbgenerated("gen_random_uuid()::text"))
  storeId                 String
  store                   Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  number                  Int
  status                  OrderStatus       @default(PENDING)
  fulfillmentStatus       FulfillmentStatus @default(UNFULFILLED)
  carrier                 String?
  trackingCode            String?
  trackingUrl             String?
  shippedAt               DateTime?
  deliveredAt             DateTime?
  shippingAddress         Json?
  confirmationEmailSentAt DateTime?
  stockReleasedAt         DateTime?
  customerEmail         String?
  customerName          String?
  customerPhone         String?
  customerDocument      String?
  totalInCents          Int
  currency              String      @default("brl")
  stripeSessionId       String?     @unique
  stripePaymentIntentId String?
  paidAt                DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  items                 OrderItem[]
  events                OrderEvent[]

  @@unique([storeId, number])
  @@index([storeId, status])
  @@index([storeId, createdAt])
}

model OrderItem {
  id               String   @id @default(cuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName      String
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantLabel     String?
  sku              String?
  unitPriceInCents Int
  quantity         Int

  @@index([orderId])
}

model OrderEvent {
  id        String           @id @default(cuid())
  orderId   String
  order     Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      OrderEventType
  actor     OrderEventActor
  message   String
  createdAt DateTime         @default(now())

  @@index([orderId, createdAt])
}
