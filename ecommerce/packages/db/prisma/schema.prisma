generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  description  String?
  logoUrl      String?
  primaryColor String    @default("#1f2937")
  accentColor  String    @default("#f59e0b")
  currency     String    @default("brl")
  customDomain String?   @unique
  nextOrderNumber Int    @default(1001)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]
  orders       Order[]
  memberships  Membership[]
  slugRedirects SlugRedirect[]
  categories   Category[]
  aiGenerations AiGeneration[]
  whatsapp     String?
  customers    Customer[]
  coupons      Coupon[]
  promotions   Promotion[]
  abandonedCarts AbandonedCart[]
  reviews      Review[]
  pages        Page[]
  apiKeys          ApiKey[]
  webhookEndpoints WebhookEndpoint[]
  cookieConsentLogs CookieConsentLog[]

  // F4.1: página inicial por seções — JSON validado em código (Zod), nunca no banco; uma store
  // nova nasce com um layout padrão (ver seed.ts e actions/auth.ts). Rascunho nulo = sem rascunho
  // pendente (a vitrine sempre lê `homeSections`, nunca o rascunho).
  homeSections      Json    @default("[]")
  homeSectionsDraft  Json?

  // F4.2: menu configurável e rodapé (razão social/CNPJ/endereço exigidos pelo Decreto 7.962/2013)
  navigation   Json      @default("[]")
  socialLinks  Json      @default("{}")
  legalName    String?
  taxId        String?
  legalAddress Json?

  // F4.4: tema pronto + fonte, trocam só CSS (nunca exigem mudar conteúdo/seções)
  theme Theme @default(CLASSICO)
  font  Font  @default(SANS)

  // F4.5: favicon por loja, aviso no topo, loja em construção com senha
  faviconUrl              String?
  announcementBar         String?
  maintenanceMode         Boolean   @default(false)
  maintenancePasswordHash String?

  // F5.2: IDs de pixels/analytics — os scripts só carregam depois do aceite no banner de cookies
  gaId         String?
  gtmId        String?
  metaPixelId  String?
  tiktokPixelId String?

  // F6.3: plano e cobrança (Stripe Billing) do lojista — nada a ver com o Stripe do checkout da
  // vitrine (F1.4 já decidiu por uma conta global; esta é a assinatura que o LOJISTA paga à plataforma)
  plan                 Plan       @default(FREE)
  planStatus           PlanStatus @default(ACTIVE)
  trialEndsAt          DateTime?
  stripeCustomerId     String?    @unique
  stripeSubscriptionId String?    @unique

  // F6.5: verificação de domínio próprio por TXT (_multistore.<domínio>) antes da vitrine responder
  domainStatus            DomainStatus?
  domainVerificationToken String?
  domainClaimedAt         DateTime?

  // F6.7: dispensa o checklist de primeiros passos no painel
  onboardingDismissedAt DateTime?
}

// F6.8: chave de API pública (REST /api/v1) — hash guardado, a chave em texto puro só existe uma
// vez, na hora da criação (mesmo padrão de token de uso único, mas sem expiração: fica até revogar)
model ApiKey {
  id         String    @id @default(cuid())
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique
  prefix     String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([storeId])
}

// F6.8: webhook de saída — `secret` assina o corpo (HMAC-SHA256) pra quem recebe confirmar a origem
model WebhookEndpoint {
  id         String            @id @default(cuid())
  storeId    String
  store      Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  url        String
  secret     String
  events     String[]
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now())
  deliveries WebhookDelivery[]

  @@index([storeId])
}

enum WebhookDeliveryStatus {
  SUCCESS
  FAILED
}

// F6.8: uma linha por TENTATIVA de entrega (histórico completo, não só o resultado final)
model WebhookDelivery {
  id                String                @id @default(cuid())
  webhookEndpointId String
  webhookEndpoint   WebhookEndpoint       @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)
  event             String
  status            WebhookDeliveryStatus
  attempt           Int
  responseStatus    Int?
  createdAt         DateTime              @default(now())

  @@index([webhookEndpointId, createdAt])
}

enum CookieConsentDecision {
  ACCEPTED
  REJECTED
}

// F6.11: registro de auditoria do banner de cookies — deliberadamente SEM nada que identifique o
// visitante (nem IP, nem cookie id); só prova que o mecanismo de consentimento existiu e funcionou
model CookieConsentLog {
  id        String                 @id @default(cuid())
  storeId   String
  store     Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  decision  CookieConsentDecision
  createdAt DateTime               @default(now())

  @@index([storeId, createdAt])
}

enum Plan {
  FREE
  ESSENCIAL
  PRO
}

enum PlanStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
}

enum DomainStatus {
  PENDING
  VERIFIED
}

enum Theme {
  CLASSICO
  MODERNO
  MINIMALISTA
}

enum Font {
  SANS
  SERIF
  MONO
}

// F4.3: páginas institucionais (Sobre nós, Trocas e devoluções, etc.) — conteúdo em Markdown,
// sanitizado na renderização (nunca confia em HTML colado, ver `@repo/db/markdown`).
model Page {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  slug      String
  title     String
  content   String   @default("")
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // F5.1: SEO técnico — em branco usa title/content como fallback na página
  seoTitle       String?
  seoDescription String?

  @@unique([storeId, slug])
}

// F2.8: um registro por chamada à IA, só pra contar o limite diário por loja (sem TTL/reset —
// a consulta já filtra por "hoje").
model AiGeneration {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
}

// F3.1: conta do cliente por loja (e-mail único por loja, não globalmente)
model Customer {
  id               String    @id @default(cuid())
  storeId          String
  store            Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  email            String
  name             String?
  phone            String?
  document         String?
  acceptsMarketing Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  orders           Order[]
  addresses        CustomerAddress[]
  loginTokens      CustomerLoginToken[]
  reviews          Review[]

  // F6.11: LGPD — quando aceitou receber marketing (não só o booleano) e, se anonimizado a
  // pedido, quando isso aconteceu (nome/e-mail/telefone/documento já viraram placeholders)
  marketingConsentAt DateTime?
  anonymizedAt        DateTime?

  @@unique([storeId, email])
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  zip        String
  street     String
  number     String
  complement String?
  district   String
  city       String
  state      String
  createdAt  DateTime @default(now())

  @@index([customerId])
}

// Login sem senha: token de uso único, guardado com hash (como uma redefinição de senha)
model CustomerLoginToken {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  // F6.1: sobe a cada troca de senha — invalida toda sessão (JWT) assinada com a versão antiga,
  // mesmo que o token ainda não tenha expirado ("sair de todos os dispositivos")
  sessionVersion  Int       @default(1)
  emailVerifiedAt DateTime?

  // F6.2: um usuário pode ter várias lojas (no lugar de User.storeId único)
  memberships Membership[]
  tokens      UserToken[]
}

enum Role {
  OWNER
  ADMIN
  OPERADOR
}

// F6.2: liga usuário a loja com um papel. Um usuário pode ter N memberships (N lojas); uma loja
// pode ter N memberships (N usuários na equipe).
model Membership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  role      Role
  createdAt DateTime @default(now())

  @@unique([userId, storeId])
  @@index([storeId])
}

enum UserTokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFY
  TEAM_INVITE
}

// F6.1/F6.2: token de uso único por hash (mesmo padrão de CustomerLoginToken) — serve redefinição
// de senha, verificação de e-mail e convite de equipe (purpose distingue o fluxo)
model UserToken {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   UserTokenPurpose
  // Só preenchido para TEAM_INVITE: vincula o token à loja/membership específica do convite,
  // pra aceitar um convite nunca ativar a loja errada (ver acceptInvite).
  storeId   String?
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId])
}

// F6.1: substitui o Map em memória de tentativas de login — sobrevive a reinício/múltiplas instâncias
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model Product {
  id           String      @id @default(cuid())
  storeId      String
  store        Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name         String
  slug         String
  description  String      @default("")
  priceInCents Int
  compareAtPriceInCents Int?
  promoStartsAt DateTime?
  promoEndsAt   DateTime?
  images       String[]
  imageAlts    String[]    @default([])
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  orderItems   OrderItem[]
  redirects    SlugRedirect[]
  categories   Category[]
  options      ProductOption[]
  variants     ProductVariant[]
  reviews      Review[]

  // F5.1: SEO técnico — em branco usa name/description como fallback na página
  seoTitle       String?
  seoDescription String?

  // F5.3: feeds de produtos (Google Merchant Center / catálogo da Meta)
  brand     String?
  gtin      String?
  condition ProductCondition @default(NEW)

  @@unique([storeId, slug])
  @@index([storeId, active])
}

enum ProductCondition {
  NEW
  USED
  REFURBISHED
}

enum CouponType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

// F3.2: cupom de desconto por loja. `value` é a porcentagem (1-100) para PERCENT ou os centavos
// para FIXED; ignorado em FREE_SHIPPING (que hoje só "zera" o selo, já que frete ainda não existe — F1.6).
model Coupon {
  id                 String     @id @default(cuid())
  storeId            String
  store              Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code               String
  type               CouponType
  value              Int        @default(0)
  minOrderInCents    Int?
  startsAt           DateTime?
  endsAt             DateTime?
  maxUses            Int?
  maxUsesPerCustomer Int?
  active             Boolean    @default(true)
  usesCount          Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@unique([storeId, code])
}

enum PromotionType {
  BUY_X_PAY_Y
  QUANTITY_DISCOUNT
}

// F3.3: regras automáticas por produto (ou toda a loja, se productIds vazio). Escopo reduzido a
// quantidade (ver Decisões) — "à vista no Pix" e "frete grátis por região" dependem de F1.5/F1.6,
// que ainda não existem.
model Promotion {
  id          String        @id @default(cuid())
  storeId     String
  store       Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  type        PromotionType
  buyQuantity Int?
  payQuantity Int?
  minQuantity Int?
  percentOff  Int?
  productIds  String[]      @default([])
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([storeId, active])
}

// F3.4: carrinho salvo quando o cliente informa e-mail no checkout mas não conclui o pagamento.
model AbandonedCart {
  id             String    @id @default(cuid())
  storeId        String
  store          Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  token          String    @unique @default(dbgenerated("gen_random_uuid()::text"))
  email          String
  name           String?
  phone          String?
  items          Json
  remindedAt1h   DateTime?
  remindedAt24h  DateTime?
  recoveredOrderId String?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([storeId, createdAt])
}

// F3.6: avaliação de produto, moderada no admin antes de aparecer na vitrine.
model Review {
  id                 String    @id @default(cuid())
  storeId            String
  store              Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId          String
  product            Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId            String?
  order              Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerId         String?
  customer           Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  rating             Int
  text               String
  authorName         String
  verifiedPurchase   Boolean   @default(false)
  approved           Boolean   @default(false)
  createdAt          DateTime  @default(now())

  @@index([productId, approved])
  @@index([storeId, approved])
}

model ProductOption {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  values    String[]
  position  Int      @default(0)

  @@index([productId])
}

// Produto sem opções tem uma única variante "padrão" (combination: {}) — é nela que o estoque mora.
model ProductVariant {
  id                    String      @id @default(cuid())
  productId             String
  product               Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                   String?
  combination           Json        @default("{}")
  priceInCents          Int?
  compareAtPriceInCents Int?
  stock                 Int         @default(0)
  weightInGrams         Int?
  imageUrl              String?
  position              Int         @default(0)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  orderItems            OrderItem[]

  @@index([productId])
}

model Category {
  id          String     @id @default(cuid())
  storeId     String
  store       Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String     @default("")
  imageUrl    String?
  position    Int        @default(0)
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // F5.1: SEO técnico — em branco usa name/description como fallback na página
  seoTitle       String?
  seoDescription String?

  @@unique([storeId, slug])
  @@index([storeId, parentId])
}

model SlugRedirect {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  fromSlug  String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([storeId, fromSlug])
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELED
  REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  SHIPPED
  DELIVERED
}

enum OrderEventType {
  CREATED
  PAID
  FAILED
  EXPIRED
  SHIPPED
  DELIVERED
  CANCELED
  REFUNDED
  EMAIL_SENT
  NOTE
}

enum OrderEventActor {
  SYSTEM
  MERCHANT
  CUSTOMER
}

model Order {
  id                      String            @id @default(cuid())
  publicToken             String            @unique @default(dbgenerated("gen_random_uuid()::text"))
  storeId                 String
  store                   Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  number                  Int
  status                  OrderStatus       @default(PENDING)
  fulfillmentStatus       FulfillmentStatus @default(UNFULFILLED)
  carrier                 String?
  trackingCode            String?
  trackingUrl             String?
  shippedAt               DateTime?
  deliveredAt             DateTime?
  shippingAddress         Json?
  confirmationEmailSentAt DateTime?
  stockReleasedAt         DateTime?
  refundedAt              DateTime?
  // F5.4: idempotência dos e-mails transacionais novos (mesmo esquema de confirmationEmailSentAt)
  receivedEmailSentAt     DateTime?
  merchantNotifiedAt      DateTime?
  deliveryEmailSentAt     DateTime?
  customerEmail         String?
  customerName          String?
  customerPhone         String?
  customerDocument      String?
  customerId            String?
  customer              Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  couponCode            String?
  discountInCents       Int         @default(0)
  reviewRequestSentAt   DateTime?
  totalInCents          Int
  currency              String      @default("brl")
  stripeSessionId       String?     @unique
  stripePaymentIntentId String?
  paidAt                DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  items                 OrderItem[]
  events                OrderEvent[]
  reviews               Review[]

  @@unique([storeId, number])
  @@index([storeId, status])
  @@index([storeId, createdAt])
  @@index([customerId])
}

model OrderItem {
  id               String   @id @default(cuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName      String
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantLabel     String?
  sku              String?
  unitPriceInCents Int
  quantity         Int

  @@index([orderId])
}

model OrderEvent {
  id        String           @id @default(cuid())
  orderId   String
  order     Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      OrderEventType
  actor     OrderEventActor
  message   String
  createdAt DateTime         @default(now())

  @@index([orderId, createdAt])
}
