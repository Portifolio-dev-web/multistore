# ---------- Banco de dados ----------
POSTGRES_USER=vitrine
POSTGRES_PASSWORD=vitrine_dev_password
POSTGRES_DB=vitrine
# Dentro do docker-compose o host é "postgres". Rodando fora do Docker, troque por "localhost".
DATABASE_URL=postgresql://vitrine:vitrine_dev_password@postgres:5432/vitrine?schema=public

# ---------- Stripe (obrigatório) ----------
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=replace_with_your_stripe_test_secret_key
# Gerado por `stripe listen` (dev) ou pelo endpoint de webhook no Dashboard (produção)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# ---------- Storefront ----------
# URL pública da vitrine principal (lojas em /{slug})
STOREFRONT_URL=http://localhost:3000
# Domínio base dos subdomínios: loja-demo.localhost:3000 funciona no Chrome/Firefox sem DNS.
# Em produção: vitrine.com.br (com DNS curinga *.vitrine.com.br). Deixe vazio para desativar.
STOREFRONT_ROOT_DOMAIN=localhost:3000

# ---------- Upload de imagens (qualquer storage compatível com S3) ----------
# Padrão: RustFS do docker-compose (S3_INIT_BUCKET=true cria o bucket público automaticamente).
# AWS S3: remova S3_ENDPOINT, S3_FORCE_PATH_STYLE=false, S3_INIT_BUCKET=false.
# Cloudflare R2: S3_REGION=auto, S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com, S3_PUBLIC_URL=https://pub-xxx.r2.dev
S3_INIT_BUCKET=true
S3_REGION=us-east-1
S3_ENDPOINT=http://storage:9000
S3_FORCE_PATH_STYLE=true
S3_BUCKET=vitrine-media
S3_ACCESS_KEY_ID=vitrine-storage
S3_SECRET_ACCESS_KEY=troque-esta-senha-storage
# URL pública (acessível pelo navegador) onde as imagens são servidas
S3_PUBLIC_URL=http://localhost:9000/vitrine-media

# ---------- E-mail (SMTP genérico: Resend, SendGrid, SES, Mailgun, Gmail…) ----------
# Padrão: Mailpit do docker-compose (veja os e-mails em http://localhost:8025)
# Resend: SMTP_HOST=smtp.resend.com SMTP_PORT=465 SMTP_SECURE=true SMTP_USER=resend SMTP_PASSWORD=re_...
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=pedidos@vitrine.local

# ---------- Admin ----------
# Gere com: openssl rand -base64 32
# Usado também pela sessão do cliente (F3.1) e pelo link de avaliação verificada (F3.6) na vitrine
AUTH_SECRET=troque-por-um-segredo-longo-e-aleatorio
# "false" para rodar em http://localhost; em produção (https) use "true"
COOKIE_SECURE=false
# "false" desativa o cadastro de novos lojistas em /register
ALLOW_REGISTRATION=true

# ---------- Jobs periódicos (F3.4/F3.6, opcional) ----------
# Protege /api/cron/* na vitrine. Sem isso definido, os dois endpoints sempre recusam (401).
# Agende a chamada por fora (cron do host, GitHub Actions scheduled, etc.):
# curl -H "Authorization: Bearer $CRON_SECRET" https://sua-loja.com/api/cron/abandoned-carts
CRON_SECRET=
# Dias após a entrega pra mandar o e-mail pedindo avaliação (F3.6)
REVIEW_REQUEST_DAYS_AFTER_DELIVERY=7

# ---------- IA (opcional, F2.8) ----------
# Sem ANTHROPIC_API_KEY o botão "Gerar com IA" do formulário de produto fica escondido.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ---------- Seed (opcional) ----------
# Se definidos, o seed cria um lojista para a "Loja Demo"
SEED_ADMIN_EMAIL=lojista@demo.com
SEED_ADMIN_PASSWORD=TroqueEssaSenha123
